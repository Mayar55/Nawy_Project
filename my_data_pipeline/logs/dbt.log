[0m02:42:56.348288 [debug] [Thread-4 (]: On model.my_data_pipeline.fact_leads: /* {"app": "dbt", "dbt_version": "1.12.5", "profile_name": "my_data_pipeline", "target_name": "dev", "node_id": "model.my_data_pipeline.fact_leads"} */

  
    

  create  table "nawy_project_db"."dwh"."fact_leads__dbt_tmp"
  
  
    as
  
  (
    


    SELECT
        l.id,
        l.is_seller,
        l.is_buyer,
        l.best_time_to_call,
        l.status_name,
        l.customer_id,
        l.budget,
        l.original_source_id,
        lead_type.lead_type,
        src.lead_source,
        methods.contact_method,
        d1.full_date AS created_at,
        d2.full_date AS updated_at,
        d3.full_date AS date_of_last_contact,
        loc.*,
        camp.campaign_standardized,
        camp.campaign_maker,
        camp.campaign_type
    FROM
        "nawy_project_db"."dwh"."std_leads" l
        LEFT JOIN "nawy_project_db"."dwh"."dim_lead_type"
        lead_type
        ON MD5(
            l.lead_type_id :: text
        ) = lead_type.lead_type_id
        LEFT JOIN "nawy_project_db"."dwh"."dim_contact_method"
        methods
        ON MD5(
            l.method_of_contact
        ) = methods.contact_method_id
        LEFT JOIN "nawy_project_db"."dwh"."dim_lead_source"
        src
        ON MD5(
            l.lead_source
        ) = src.lead_source_id
        LEFT JOIN "nawy_project_db"."dwh"."dim_date"
        d1
        ON MD5(
            l.created_at :: text
        ) = d1.date_id
        LEFT JOIN "nawy_project_db"."dwh"."dim_date"
        d2
        ON MD5(
            l.updated_at :: text
        ) = d2.date_id
        LEFT JOIN "nawy_project_db"."dwh"."dim_date"
        d3
        ON MD5(
            l.last_contact_date :: text
        ) = d3.date_id
        LEFT JOIN "nawy_project_db"."dwh"."dim_campaign"
        camp
        ON MD5(
            l.campaign
        ) = camp.campaign_id
        LEFT JOIN LATERAL (
            SELECT
                s.area_id,
                s.compound_id,
                s.location_id,
                s.location
            FROM
                "nawy_project_db"."dwh"."fact_sales" s
            WHERE
                s.lead_id = l.id
            ORDER BY
                s.id
            LIMIT 1
        ) loc ON TRUE
  );
  
