  create  table "nawy_project_db"."dwh"."fact_sales__dbt_tmp"
  
  
    as
  
  (
    


SELECT
DISTINCT ON (s.sale_id)
s.sale_id as id,
l.lead_id,
dim_lead_typ.lead_type_id as lead_type_id,
prop_typ.property_type_id,
c.category_id as sale_category_id,









FROM "nawy_project_db"."stg_schema"."stg_sales" s
JOIN "nawy_project_db"."stg_schema"."stg_leads" l 

ON s.lead_id = l.lead_id


LEFT JOIN "nawy_project_db"."dwh"."dim_sale_category" c  ON md5(cast(coalesce(cast(sale_category as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) = c.category_id
LEFT JOIN "nawy_project_db"."dwh"."dim_property_type" prop_typ  ON md5(cast(coalesce(cast(s.property_type_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) = prop_typ.property_type_id 
LEFT JOIN "nawy_project_db"."dwh"."dim_lead_type" dim_lead_typ  ON md5(cast(coalesce(cast(lead.lead_type_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) = dim_lead_typ.lead_type_id 





  );
  
